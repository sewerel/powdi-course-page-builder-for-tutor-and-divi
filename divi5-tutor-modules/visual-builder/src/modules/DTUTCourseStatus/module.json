{
    "name": "divi-tutor/status",
    "title": "Divi Tutor Course Progress",
    "titles": "Divi Tutor Course Progress",
    "category": "module",
    "moduleIcon": "divi-tutor/status",
    "moduleClassName": "divi_tutor_course_status",
    "moduleOrderClassName": "divi_tutor_course_status",
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {}
                },
                "decoration": {
                    "spacing": {},
                    "transform": {},
                    "attributes": {},
                    "animation": {},
                    "overflow": {},
                    "disabledOn": {},
                    "transition": {},
                    "position": {},
                    "sizing": {},
                    "background": {},
                    "zIndex": {},
                    "scroll": {}
                }
            }
        },
        "bar": {
            "type": "object",
            "selector": "{{selector}} .divi-tutor-progress-bar",
            "styleProps": {
                "font": {
                    "selector": "{{selector}} .divi-tutor-progress-text"
                }
            },
            "settings": {
                "decoration": {
                    "background": {
                        "component": {
                            "props": {
                                "fieldLabel": "Progress",
                                "groupLabel": "Progress Background",
                                "hidePanels": [
                                    "mask",
                                    "pattern",
                                    "video",
                                    "image"
                                ]
                            }
                        }
                    },
                    "border": {
                        "component": {
                            "props": {
                                "groupLabel": "Progress Border",
                                "fieldLabel": "Progress",
                                "fields": {
                                    "styles": {
                                        "render": false
                                    }
                                }
                            }
                        }
                    },
                    "font": {
                        "priority": 10,
                        "render": true,
                        "component": {
                            "props": {
                                "groupLabel": "Status Font",
                                "fieldLabel": "Status"
                            }
                        }
                    }
                },
                "advanced": {
                    "thickness": {
                        "groupType": "group-item",
                        "item": {
                            "label": "Progress Thickness",
                            "groupSlug": "designSize",
                            "attrName": "bar.advanced.thickness",
                            "description": "Adjust the progress bar thickness",
                            "priority": 10,
                            "render": true,
                            "defaultAttr": {
                                "desktop": {
                                    "value": "7px"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "allowedUnits": [
                                        "px"
                                    ],
                                    "defaultUnit": "px",
                                    "max": 50,
                                    "step": 1,
                                    "minLimit": 1
                                }
                            },
                            "features": {
                                "dynamicContent": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                }
            }
        },
        "line": {
            "type": "object",
            "selector": "{{selector}} .divi-tutor-progress-line",
            "settings": {
                "decoration": {
                    "background": {
                        "component": {
                            "type": "group",
                            "name": "divi/background",
                            "props": {
                                "fieldLabel": "Line",
                                "groupLabel": "Progress Line Color",
                                "hidePanels": [
                                    "mask",
                                    "pattern",
                                    "video",
                                    "image"
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "designSize": {
                "panel": "content",
                "priority": 20,
                "groupName": "designSize",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Progress Size"
                    }
                }
            }
        }
    }
}
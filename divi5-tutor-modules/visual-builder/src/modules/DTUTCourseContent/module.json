{
    "name": "divi-tutor/course-content",
    "title": "Divi Tutor Course Content",
    "titles": "Divi Tutor Course Contents",
    "category": "module",
    "moduleIcon": "divi-tutor/content",
    "moduleClassName": "divi_tutor_course_content",
    "moduleOrderClassName": "divi_tutor_course_content",
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {}
                },
                "advanced": {
                    "gap": {
                        "groupType": "group-item",
                        "item": {
                            "label": "Space Between Topics",
                            "groupSlug": "designLayout",
                            "attrName": "module.advanced.gap",
                            "description": "Adjust the spacing between Topics",
                            "priority": 10,
                            "render": true,
                            "defaultAttr": {
                                "desktop": {
                                    "value": "20px"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "defaultUnit": "px",
                                    "max": 500,
                                    "step": 1,
                                    "minLimit": 0
                                }
                            },
                            "features": {
                                "responsive": true,
                                "hover": false
                            }
                        }
                    }
                },
                "decoration": {
                    "spacing": {},
                    "transform": {},
                    "attributes": {},
                    "animation": {},
                    "overflow": {},
                    "disabledOn": {},
                    "transition": {},
                    "position": {},
                    "zIndex": {},
                    "scroll": {}
                }
            }
        },
        "topics": {
            "type": "object",
            "selector": "{{selector}} .tutor-accordion .tutor-accordion-item-header",
            "styleProps": {
                "border": {
                    "propertySelectors": {
                        "desktop": {
                            "value": {
                                "border-radius": "{{selector}} .tutor-accordion-item",
                                "border-style": "{{selector}} .tutor-accordion-item,{{selector}} .tutor-accordion-item-body-content"
                            }
                        }
                    }
                }
            },
            "default": {
                "advanced": {
                    "tabs": {
                        "desktop": {
                            "value": "default"
                        }
                    }
                }
            },
            "settings": {
                "decoration": {
                    "spacing": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.decoration.spacing",
                            "priority": 21,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/spacing",
                                "props": {
                                    "grouped": true,
                                    "fieldLabel": "Topics",
                                    "groupLabel": "Topics Padding",
                                    "fields": {
                                        "margin": {
                                            "render": false
                                        }
                                    }
                                }
                            },
                            "features": {
                                "hover": false
                            }
                        }
                    },
                    "border": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.decoration.border",
                            "priority": 22,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/border",
                                "props": {
                                    "grouped": true,
                                    "fieldLabel": "Topics",
                                    "groupLabel": "Topics Border"
                                }
                            }
                        }
                    },
                    "background": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.decoration.background",
                            "priority": 23,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/background",
                                "props": {
                                    "grouped": true,
                                    "fieldLabel": "Topics",
                                    "groupLabel": "Topics Background",
                                    "hidePanels": [
                                        "mask",
                                        "pattern",
                                        "video",
                                        "image"
                                    ]
                                }
                            }
                        }
                    },
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.decoration.font",
                            "priority": 32,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font",
                                "props": {
                                    "grouped": true,
                                    "groupLabel": "Topics Text",
                                    "fieldLabel": "Topics",
                                    "fields": {
                                        "textAlign": {
                                            "render": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "advanced": {
                    "tabs": {
                        "groupType": "group-item",
                        "item": {
                            "attrName": "topics.advanced.tabs",
                            "groupSlug": "designTopics",
                            "render": true,
                            "priority": 3,
                            "component": {
                                "type": "field",
                                "name": "divi/button-options",
                                "props": {
                                    "name": "tabs",
                                    "options": {
                                        "default": {
                                            "label": "Default",
                                            "tooltip": "Default and when Topic item closed"
                                        },
                                        "active": {
                                            "label": "Open",
                                            "tooltip": "When Topic item is Open"
                                        }
                                    },
                                    "showLabel": true,
                                    "tabUi": true
                                }
                            }
                        }
                    },
                    "iconColor": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.iconColor",
                            "label": "Icon Color",
                            "description": "Icon color when topic default/closed",
                            "priority": 10,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "dynamicContent": {
                                    "type": "color"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker"
                            }
                        }
                    },
                    "iconSize": {
                        "groupType": "group-item",
                        "item": {
                            "label": "Icon Size",
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.iconSize",
                            "description": "Topic Icon size",
                            "priority": 10,
                            "render": true,
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "allowedUnits": [
                                        "px"
                                    ],
                                    "defaultUnit": "px",
                                    "max": 100,
                                    "step": 1,
                                    "minLimit": 1
                                }
                            },
                            "features": {
                                "dynamicContent": {
                                    "type": "number"
                                },
                                "responsive": true
                            }
                        }
                    },
                    "activeBackground": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.activeBackground",
                            "label": "Open Topic Background",
                            "description": "Background Color when Topic item is Open/Active",
                            "priority": 10,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "dynamicContent": {
                                    "type": "color"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/color-picker"
                            }
                        }
                    },
                    "activeColor": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.activeColor",
                            "label": "Open Text Color",
                            "description": "Text color when topic is Open/Active",
                            "priority": 10,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "dynamicContent": {
                                    "type": "color"
                                }
                            },
                            "component": {

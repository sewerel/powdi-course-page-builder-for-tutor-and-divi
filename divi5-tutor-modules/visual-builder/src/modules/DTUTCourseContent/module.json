                    "activeIconSize": {
                        "groupType": "group-item",
                        "item": {
                            "label": "Open Icon Size",
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.activeIconSize",
                            "description": "Icon size when topic toggle is active",
                            "priority": 10,
                            "render": true,
                            "defaultAttr": {
                                "desktop": {
                                    "value": "18px"
                                }
                            },
                            "component": {
                                "type": "field",
                                "name": "divi/range",
                                "props": {
                                    "allowedUnits": [
                                        "px"

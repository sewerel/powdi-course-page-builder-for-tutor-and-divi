                            "features": {
                                "dynamicContent": {
                                    "type": "number"
                                },
                                "responsive": true
                            }
                        }
                    },
                    "activeIconColor": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "designTopics",
                            "attrName": "topics.advanced.activeIconColor",
                            "label": "Open Text Color",
                            "description": "Text color when topic is active",
                            "priority": 10,
                            "render": true,
                            "features": {
                                "sticky": false,
                                "dynamicContent": {
                                    "type": "color"

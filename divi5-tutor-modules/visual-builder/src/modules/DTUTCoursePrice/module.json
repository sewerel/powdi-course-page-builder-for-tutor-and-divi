{
    "name": "divi-tutor/price",
    "title": "Divi Tutor Course Price",
    "titles": "Divi Tutor Course Prices",
    "category": "module",
    "moduleIcon": "divi-tutor/price",
    "moduleClassName": "divi_tutor_course_price",
    "moduleOrderClassName": "divi_tutor_course_price",
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {}
                },
                "decoration": {
                    "spacing": {},
                    "transform": {},
                    "attributes": {},
                    "animation": {},
                    "overflow": {},
                    "disabledOn": {},
                    "transition": {},
                    "position": {},
                    "border": {},
                    "sizing": {},
                    "background": {},
                    "zIndex": {},
                    "scroll": {}
                }
            }
        },
        "price": {
            "type": "object",
            "selector": "{{selector}} .woocommerce-Price-amount,{{selector}} .tutor-item-price",
            "settings": {
                "decoration": {
                    "font": {
                        "priority": 10,
                        "render": true,
                        "component": {
                            "props": {
                                "groupLabel": "Price Font",
                                "fieldLabel": "Price"
                            }
                        }
                    }
                }
            }
        },
        "freeTag": {
            "type": "object",
            "selector": "{{selector}} .divi-tutor-free-label",
            "settings": {
                "decoration": {
                    "font": {
                        "priority": 10,
                        "render": true,
                        "component": {
                            "props": {
                                "groupLabel": "Free Label Font",
                                "fieldLabel": "Free Label"
                            }
                        }
                    }
                },
                "advanced": {
                    "text": {
                        "groupType": "group-item",
                        "item": {
                            "label": "Text Label",
                            "groupSlug": "contentLabel",
                            "priority": 10,
                            "render": true,
                            "attrName": "freeTag.advanced.text",
                            "description": "Text displaed when course is free",
                            "features": {
                                "dynamicContent": false,
                                "responsive": false
                            },
                            "component": {
                                "name": "divi/text",
                                "type": "field"
                            }
                        }
                    }
                }
            }
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "contentLabel": {
                "panel": "content",
                "priority": 20,
                "groupName": "contentLabel",
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Free Label Text"
                    }
                }
            }
        }
    }
}